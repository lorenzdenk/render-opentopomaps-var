# Test square from Mainau island (north) to Weinfelden (south), about 15.5 x 15.5 km:
# Bodanrück, Konstanz/Kreuzlingen, Seerücken, Thurtal. Hillshade swisstopo (CH) before basemap.de (DE).
NAME=mainau-weinfelden
TITLE="Mainau–Weinfelden (OpenTopoMap)"
# bounding box: west,south,east,north (WGS84)
BBOX=9.047,47.567,9.253,47.707
MINZOOM=0
MAXZOOM=17
MAGNIFY=2
EARLY_TRAILS=2
GITHUB_SHARDS=8
PBF_URLS="https://download.geofabrik.de/europe/switzerland-latest.osm.pbf https://download.geofabrik.de/europe/germany/baden-wuerttemberg/freiburg-regbez-latest.osm.pbf"
# sharp national hillshades in priority order (render/data/fetch_hillshade.py), tile level 14 (~6.5 m here)
HILLSHADE_SOURCES="swisstopo basemapde"
HILLSHADE_LEVEL=14
