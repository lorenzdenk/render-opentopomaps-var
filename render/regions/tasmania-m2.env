# Tasmania main island incl. Bruny, Maria Island, Tasman Peninsula (without King and Flinders Island),
# everything twice as large (MAGNIFY=2): zoom 14 shows what zoom 13 shows normally, enlarged and sharp
NAME=tasmania-z14-tasveg
TITLE="Tasmanien TASVEG (gross, bis Zoom 14)"
BBOX=144.55,-43.70,148.40,-40.60
MINZOOM=0
MAXZOOM=14
MAGNIFY=2
EARLY_TRAILS=2
GITHUB_SHARDS=16
PBF_URLS="https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf"
TASVEG=1
# tracks and paths from LIST, OSM only where LIST has nothing; LIST hillshade; overlays
LIST_TRACKS=C
LIST_HILLSHADE=1
OVERLAYS="walks walkability"
