# Walensee to Chur: Walensee, Seeztal, Sarganserland, Liechtenstein, Bündner Herrschaft, Chur (about 42 x 37 km)
NAME=walensee-chur
TITLE="Walensee–Chur (OpenTopoMap)"
# bounding box: west,south,east,north (WGS84)
BBOX=9.05,46.83,9.60,47.16
MINZOOM=0
MAXZOOM=17
MAGNIFY=2
EARLY_TRAILS=2
GITHUB_SHARDS=16
PBF_URLS="https://download.geofabrik.de/europe/switzerland-latest.osm.pbf https://download.geofabrik.de/europe/liechtenstein-latest.osm.pbf"
HILLSHADE_SOURCES="swisstopo"
HILLSHADE_LEVEL=14
# contours from swissALTI3D, forest types from the BAFU broadleaf share
FINE_DEM=1
FOREST_TYPES=1
# transparent overlay: waymarked hiking routes in the manner of Waymarked Trails (own rendering, see customize_style.py)
OVERLAYS="hiking"
