# Render settings. A push that changes files in render/ starts the render workflow.

# regions to render (one after the other) (files in render/regions/: name, bounding box, zoom levels, OSM sources)
REGIONS="walensee-chur"
REGION=${REGION:-${REGIONS%% *}}
source "$(dirname "${BASH_SOURCE[0]}")/regions/$REGION.env"

# tiles = full MBTiles file, preview = a few images only (fast), profile = render time per map layer (PROFILE_ZOOMS)
PROFILE_ZOOMS="15 17"
MODE=tiles
# map font (dejavu, noto, roboto, opensans, verdana, trebuchet, helvetica, geometric, swiss)
FONT=trebuchet
# MODE=preview: font variants to compare (one font = overview sheet of all places)
PREVIEW_FONTS=trebuchet
# MODE=preview: places to render: from preview_places.txt or found automatically
# (Zeltplatz, Tor_verschlossen, Pisten, Weg_privat, Pfad_unsichtbar, Aussichtspunkt); empty = all
PREVIEW_PLACES=Pisten,Pisten_4WD,Tor_verschlossen,Trail_Namen_Zoom14
# tile image format: webp:75 (lossy WebP, quality 75; 85 is about a third larger) or png8:m=h (PNG, 256 colours)
TILE_FORMAT=${TILE_FORMAT:-webp:75}
# 2 = 512 px tiles ("@2x", sharp on phones)
SCALE=2
# 2 = lines, symbols and labels twice as large (each zoom level shows the content of the next lower one,
# so render one zoom level more for the same detail); 1 = like OpenTopoMap. Can be set per region.
MAGNIFY=${MAGNIFY:-2}
# split the tiles into SHARDS parts (set by the GitHub workflow; on the laptop leave 1)
SHARDS=${SHARDS:-1}
# number of parallel GitHub jobs for MODE=tiles (max. 20 at the same time on the free plan)
GITHUB_SHARDS=${GITHUB_SHARDS:-8}
